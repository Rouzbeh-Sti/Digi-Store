            فروشنده هستم
          </button>
        </div>

        {successMessage && (
          <div className="mb-5 p-3.5 bg-green-50 border border-green-200 text-green-700 rounded-xl text-xs font-bold flex items-center gap-2">
            <span>✓</span>
            <span>{successMessage}</span>
